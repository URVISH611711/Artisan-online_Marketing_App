# ─── Database ────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → URI
# Use the pooled connection (port 6543) if you hit connection limits.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Security ────────────────────────────────────────────────────
# REQUIRED. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, every JWT is signed with a public default value — anyone can forge a token.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ─── Supabase Storage (product images) ───────────────────────────
# Project Settings → API. The service key bypasses RLS: it belongs ONLY here,
# on the server. NEVER put it in the Expo app or any EXPO_PUBLIC_* variable.
# If either value is blank, images fall back to the local ./uploads directory.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Email (OTP delivery) ────────────────────────────────────────
# Gmail requires an App Password, not your account password.
# If blank, OTPs are printed to the backend console instead of emailed.
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Local AI pipeline ───────────────────────────────────────────
# Every model runs on this machine. There are no AI API keys, by design.
MODEL_DIR=models
UPLOADS_DIR=uploads
DEVICE=auto

# Optional Qwen2.5-VL sidecar (see ../vision_service). The pipeline degrades
# gracefully when it is not running, so leaving this untouched is fine.
VISION_SERVICE_URL=http://127.0.0.1:8001
